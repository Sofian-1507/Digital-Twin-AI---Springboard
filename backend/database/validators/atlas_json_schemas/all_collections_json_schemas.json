{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "MongoDB Atlas Server-Side JSON Schema Validation definitions for all Digital Twin AI collections. Deploy these via the Atlas Admin API or Cluster Schema Validation UI to enforce database engine-level constraints regardless of client ODM.",
  "collections": {
    "users": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["email", "password_hash", "profile", "preferences", "active_goals", "digital_twin_state", "created_at", "updated_at"],
        "properties": {
          "email": {
            "bsonType": "string",
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "description": "Must be a valid email string and is required"
          },
          "profile": {
            "bsonType": "object",
            "required": ["name", "age", "monthly_income_baseline", "risk_tolerance"],
            "properties": {
              "name": { "bsonType": "string", "minLength": 2, "maxLength": 100 },
              "age": { "bsonType": "int", "minimum": 13, "maximum": 120 },
              "monthly_income_baseline": { "bsonType": "decimal" },
              "risk_tolerance": { "enum": ["CONSERVATIVE", "MODERATE", "AGGRESSIVE"] }
            }
          },
          "active_goals": {
            "bsonType": "array",
            "maxItems": 30,
            "description": "Hard-capped at 30 items to enforce Rule of 100 and prevent document growth"
          }
        }
      }
    },
    "habit_tracking": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["user_id", "sleep_hours", "exercise_minutes", "water_intake_liters", "screen_time_hours", "burnout_risk_cluster", "log_date", "created_at"],
        "properties": {
          "user_id": { "bsonType": "objectId" },
          "sleep_hours": { "bsonType": "decimal" },
          "exercise_minutes": { "bsonType": "int", "minimum": 0, "maximum": 1440 },
          "water_intake_liters": { "bsonType": "decimal" },
          "screen_time_hours": { "bsonType": "decimal" },
          "burnout_risk_cluster": { "enum": ["LOW_RISK", "MODERATE_RISK", "HIGH_RISK", "CRITICAL_BURNOUT", "UNKNOWN"] },
          "log_date": { "bsonType": "date" }
        }
      }
    }
  }
}
