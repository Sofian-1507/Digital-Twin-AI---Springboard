{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "MongoDB Atlas Vector Search Index Definitions for Digital Twin AI. These HNSW vector search indexes must be created via the MongoDB Atlas UI (Database -> Browse Collections -> Search Indexes -> Create Search Index -> JSON Editor) or via the MongoDB Atlas Admin API. Mongoose and Node.js drivers cannot create vector indexes automatically.",
  "indexes": [
    {
      "collectionName": "recommendations",
      "indexName": "idx_rec_vector_search",
      "definition": {
        "fields": [
          {
            "type": "vector",
            "path": "embedding",
            "numDimensions": 768,
            "similarity": "cosine"
          },
          {
            "type": "filter",
            "path": "user_id"
          },
          {
            "type": "filter",
            "path": "category"
          },
          {
            "type": "filter",
            "path": "status"
          }
        ]
      }
    },
    {
      "collectionName": "chat_history",
      "indexName": "idx_chat_vector_search",
      "definition": {
        "fields": [
          {
            "type": "vector",
            "path": "messages.embedding",
            "numDimensions": 768,
            "similarity": "cosine"
          },
          {
            "type": "filter",
            "path": "user_id"
          }
        ]
      }
    }
  ]
}
