# ==============================================================================
# Digital Twin AI — MongoDB Atlas Database Configuration (.env.example)
# ==============================================================================

# MongoDB Atlas Connection URI (Replace with your Atlas Cluster SRV string)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority&appName=DigitalTwinAI
MONGODB_URI=mongodb://localhost:27017

# Target Database Name
MONGODB_DB_NAME=digital_twin_ai_prod

# Connection Pool Settings (Atlas Dedicated M10+ Best Practices)
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_CONNECT_TIMEOUT_MS=10000

# Application Environment (development | staging | production)
NODE_ENV=development
